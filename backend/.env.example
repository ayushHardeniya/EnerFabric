# Copy to .env and adjust as needed for local development.

APP_NAME=EnerFabric
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Matches the credentials in the project's docker-compose.yml postgres service.
# Host port is 5433 (not the default 5432) — see docker-compose.yml's
# postgres service comment / CLAUDE.md Milestone 4 for why.
DATABASE_URL=postgresql+psycopg://enerfabric:enerfabric@localhost:5433/enerfabric

# Matches the Mosquitto service in the project's docker-compose.yml.
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_ENABLED=true
