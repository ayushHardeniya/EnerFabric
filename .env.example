# Copy to .env (repo root) and adjust before a real deployment.
# Read automatically by `docker compose` for the services in
# docker-compose.yml — see README.md's Deployment section.
#
# Not needed for local dev (`make infra-up` / `make run-backend` /
# `npm run dev`) — those use backend/.env and frontend/.env.local
# instead, unchanged from before.

# --- PostgreSQL (postgres/backend/migrate/simulator services) ---
# Change these for any real deployment; the defaults below match the
# project's local-dev defaults and are not secure for a public VM.
POSTGRES_USER=enerfabric
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enerfabric

# --- Host port bindings ---
# postgres/mosquitto/backend/frontend are all bound to 127.0.0.1 only
# (never exposed publicly, regardless of these values) — nginx is the
# single public port. See docker-compose.yml.
POSTGRES_PORT=5433
MOSQUITTO_PORT=1883
BACKEND_PORT=8000
FRONTEND_PORT=3000
# nginx — the only port that needs to be open in the VM's firewall.
HTTP_PORT=80

# --- Frontend build-time backend URL ---
# Leave unset/empty (the default): the frontend then calls /api/...
# same-origin, which nginx routes to the backend — no public IP needed.
# Baked into the frontend's client bundle at build time (see
# frontend/Dockerfile), so only change this if bypassing nginx.
NEXT_PUBLIC_API_URL=

ENVIRONMENT=production
