# Copy to .env (repo root) and adjust before a real deployment.
# Read automatically by `docker compose` for the services in
# docker-compose.yml — see README.md's Deployment section.
#
# Not needed for local dev (`make infra-up` / `make run-backend` /
# `npm run dev`) — those use backend/.env and frontend/.env.local
# instead, unchanged from before.

# --- PostgreSQL (postgres/backend/migrate/simulator services) ---
# Change these for any real deployment; the defaults below match the
# project's local-dev defaults and are not secure for a public VM.
POSTGRES_USER=enerfabric
POSTGRES_PASSWORD=change-me
POSTGRES_DB=enerfabric

# --- Host port bindings ---
# postgres/mosquitto are bound to 127.0.0.1 only (never exposed
# publicly, regardless of this value) — see docker-compose.yml.
POSTGRES_PORT=5433
MOSQUITTO_PORT=1883
# backend/frontend are bound to all interfaces so the demo can reach
# them from outside the VM — open these two ports in the VM's firewall.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Frontend build-time backend URL ---
# The URL a BROWSER will use to reach the backend — i.e. the VM's
# public IP/hostname, not "postgres"/"backend"/"localhost". Baked into
# the frontend's client bundle at build time (see frontend/Dockerfile),
# so this must be set correctly *before* `docker compose up --build`.
# Example: http://<vm-public-ip>:8000
NEXT_PUBLIC_API_URL=http://localhost:8000

ENVIRONMENT=production
